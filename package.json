{
  "name": "lifepilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "LifePilot AI - Your Coding Journey, Guided by AI.",
  "scripts": {
    "setup": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n API,WEB -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server",
    "test": "npm run test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
