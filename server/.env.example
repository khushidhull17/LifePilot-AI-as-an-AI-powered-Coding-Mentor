# Server configuration. Copy this file to server/.env and fill in the values.
# Never commit your real .env file.

PORT=5000
NODE_ENV=development

# Local MongoDB (or a MongoDB Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/lifepilot

# Use a long random string in production
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google Gemini API key from https://aistudio.google.com/apikey
# Leave blank to run the app without AI (AI pages will show a setup message).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Max AI requests per user per 15 minutes
AI_RATE_LIMIT=30
